#!/usr/bin/env bash
# Input the daemon sends to the desktop. Kept as one small script so the container
# exposes a deliberate verb list rather than arbitrary shell.
set -euo pipefail
# DISPLAY selects which bot's screen this acts on; the caller always sets it.
export DISPLAY="${DISPLAY:-:99}"

case "${1:-}" in
  click)    xdotool mousemove "$2" "$3" click "${4:-1}" ;;
  dblclick) xdotool mousemove "$2" "$3" click --repeat 2 1 ;;
  move)     xdotool mousemove "$2" "$3" ;;
  scroll)   # $2=x $3=y $4=amount (negative scrolls up)
            btn=5; [ "${4:-0}" -lt 0 ] && btn=4
            xdotool mousemove "$2" "$3" click --repeat "${5:-3}" "$btn" ;;
  type)     shift; xdotool type --delay 12 -- "$*" ;;
  # Clipboard, both directions. Typing a paste character by character loses newlines
  # and tabs and takes a visible age on anything long; putting it on the X clipboard
  # and pressing ctrl+v is what a person does.
  clipset)  shift; printf '%s' "$*" | xclip -selection clipboard ;;
  clipget)  xclip -selection clipboard -o 2>/dev/null || true ;;
  key)      shift; xdotool key -- "$@" ;;
  # A profile per screen: two Chromium instances cannot share one user-data-dir, and
  # a bot's logins are its own. Downloads stay shared, which is the point of one
  # machine — a file one bot fetches, another can open.
  #
  # The debugging port is what lets a bot read the page's structure instead of
  # squinting at pixels. It is derived from the display so screens never collide, and
  # bound to 0.0.0.0 only because the daemon reaches it from outside the container —
  # the published port itself is bound to loopback on the host.
  open)     offset=$((${DISPLAY#:} - 99))
            inner=$((19222 + offset))
            outer=$((9222 + offset))
            # --class matches the dock launcher's StartupWMClass, so the window the bot
            # opens lands on the Chrome icon rather than beside it. Maximised, because
            # a bot reads the screen as a whole and a window short of the edge leaves
            # a band of nothing in every screenshot; the dock reserves its own strip.
            chromium --no-first-run --no-default-browser-check \
              --user-data-dir="$HOME/.chromium-$DISPLAY" \
              --class=routi-chrome \
              --start-maximized \
              --disable-features=TranslateUI \
              --remote-debugging-port="$inner" \
              "$2" >/dev/null 2>&1 &
            # Chromium binds DevTools to the container's loopback and ignores
            # --remote-debugging-address outside headless mode, so a published port
            # reaches nothing. socat bridges the two: it listens where the daemon can
            # reach it and forwards to where Chromium actually is.
            pgrep -f "TCP-LISTEN:$outer," >/dev/null 2>&1 || \
              socat TCP-LISTEN:$outer,fork,reuseaddr,bind=0.0.0.0 TCP:127.0.0.1:$inner \
                >/dev/null 2>&1 & ;;
  # The port this screen's browser answers on, from outside the container.
  cdpport)  echo $((9222 + ${DISPLAY#:} - 99)) ;;
  *)        echo "usage: act {click|dblclick|move|scroll|type|key|open} ..." >&2; exit 2 ;;
esac
