#!/usr/bin/env bash
# Input the daemon sends to the desktop. Kept as one small script so the container
# exposes a deliberate verb list rather than arbitrary shell.
set -euo pipefail
# DISPLAY selects which bot's screen this acts on; the caller always sets it.
export DISPLAY="${DISPLAY:-:99}"

case "${1:-}" in
  click)    xdotool mousemove "$2" "$3" click "${4:-1}" ;;
  dblclick) xdotool mousemove "$2" "$3" click --repeat 2 1 ;;
  move)     xdotool mousemove "$2" "$3" ;;
  scroll)   # $2=x $3=y $4=amount (negative scrolls up)
            btn=5; [ "${4:-0}" -lt 0 ] && btn=4
            xdotool mousemove "$2" "$3" click --repeat "${5:-3}" "$btn" ;;
  type)     shift; xdotool type --delay 12 -- "$*" ;;
  # Clipboard, both directions. Typing a paste character by character loses newlines
  # and tabs and takes a visible age on anything long; putting it on the X clipboard
  # and pressing ctrl+v is what a person does.
  clipset)  shift; printf '%s' "$*" | xclip -selection clipboard ;;
  clipget)  xclip -selection clipboard -o 2>/dev/null || true ;;
  key)      shift; xdotool key -- "$@" ;;
  # The dock and agent must open the same browser/profile.
  open)     /usr/local/bin/chrome-wrapper.sh "$2" >/dev/null 2>&1 & ;;
  # The port this screen's browser answers on, from outside the container.
  cdpport)  echo $((9222 + ${DISPLAY#:} - 99)) ;;
  *)        echo "usage: act {click|dblclick|move|scroll|type|key|open} ..." >&2; exit 2 ;;
esac
