{
  "name": "routid",
  "version": "0.1.34",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "spike": "tsx scripts/spike-auth.ts",
    "spike:session": "tsx scripts/spike-session.ts",
    "probe": "tsx scripts/probe.ts",
    "poke": "tsx scripts/poke.ts",
    "spike:isolation": "tsx scripts/spike-isolation.ts",
    "spike:grok": "tsx scripts/spike-grok.ts",
    "test:live:claude-memory": "ROUTI_LIVE_TESTS=1 tsx tests/live/claude-memory.test.ts",
    "parity": "tsx scripts/parity.ts",
    "dev:isolated": "ROUTI_DATA_DIR=$HOME/.routi-dev ROUTI_PORT=7172 tsx watch src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.261",
    "@anthropic-ai/sdk": "^0.124.0",
    "@openai/codex": "^0.153.4",
    "@routi/protocol": "workspace:^",
    "better-sqlite3": "^13.0.3",
    "openai": "^7.10.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "@novnc/novnc": "1.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
