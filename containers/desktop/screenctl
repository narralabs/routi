#!/usr/bin/env bash
# One X display per bot inside the shared desktop machine.
# Minimal stack (xfwm4 + picom + plank) — no XFCE panel / session.
set -euo pipefail

STATE=/tmp/routi-screens
mkdir -p "$STATE"

# Serialize allocation and teardown across bots. -o keeps children from holding the lock.
if [[ "${1:-}" == --locked ]]; then
  shift
elif [[ "${1:-}" == start || "${1:-}" == stop ]]; then
  exec flock -o "$STATE/.lock" "$0" --locked "$@"
fi

FIRST=99
LAST=148

display_of() {
  local id=$1
  [ -f "$STATE/$id" ] && cat "$STATE/$id" || true
}

owns_display() {
  local file
  for file in "$STATE"/*; do
    [[ "$file" == *.dbus || "$file" == "$STATE/$1" ]] && continue
    [[ -f "$file" ]] || continue
    if [[ "$(cat "$file")" == "$2" ]]; then
      echo "Display :$2 has conflicting bot assignments; screen access refused." >&2
      return 1
    fi
  done
}

is_live() {
  xdpyinfo -display ":$1" >/dev/null 2>&1
}

next_free() {
  local n
  for ((n = FIRST; n <= LAST; n++)); do
    if ! is_live "$n" && [[ ! -d "$HOME/.chromium-:$n" && ! -d "$HOME/chrome-profile-$n" ]] &&
       ! grep -qx "$n" "$STATE"/* 2>/dev/null; then
      echo "$n"
      return 0
    fi
  done
  echo "no free display" >&2
  return 1
}

start() {
  local id=$1
  local n
  n=$(display_of "$id")

  if [ -n "$n" ]; then
    owns_display "$id" "$n" || return 1
  fi
  if [ -n "$n" ] && is_live "$n"; then
    echo "$n"
    return 0
  fi

  [ -n "$n" ] || n=$(next_free)
  rm -f "/tmp/.X${n}-lock"

  export DISPLAY=":$n"
  Xvfb ":$n" -screen 0 "${SCREEN_WIDTH}x${SCREEN_HEIGHT}x${SCREEN_DEPTH}" \
    -ac +extension GLX +render -noreset -nolisten tcp \
    >/tmp/xvfb-${n}.log 2>&1 &

  local ok=
  for _ in $(seq 1 60); do
    is_live "$n" && { ok=1; break; }
    sleep 0.2
  done
  [ -n "$ok" ] || { echo "display :$n never came up" >&2; return 1; }

  # Per-screen session bus so settings don't cross bots.
  eval "$(dbus-launch --sh-syntax)"
  echo "$DBUS_SESSION_BUS_PID" > "$STATE/$id.dbus"
  export DBUS_SESSION_BUS_ADDRESS

  /usr/local/bin/start-screen.sh >/tmp/start-screen-${n}.log 2>&1 &

  echo "$n" > "$STATE/$id"
  echo "$n"
}

stop() {
  local id=$1
  local n
  n=$(display_of "$id") || true
  [ -n "$n" ] || return 0

  owns_display "$id" "$n" || return 1

  pkill -f "^Xvfb :$n( |$)" 2>/dev/null || true
  for pid in $(pgrep -u "$(id -u)" -f . 2>/dev/null || true); do
    if tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qx "DISPLAY=:$n"; then
      kill "$pid" 2>/dev/null || true
    fi
  done
  [ -f "$STATE/$id.dbus" ] && kill "$(cat "$STATE/$id.dbus")" 2>/dev/null || true
  # Keep the reservation: a future bot must not inherit this display's browser profile.
  rm -f "$STATE/$id.dbus" "/tmp/.X${n}-lock"
}

case "${1:-}" in
  start) start "$2" ;;
  stop) stop "$2" ;;
  display) n=$(display_of "$2"); [ -n "$n" ] && owns_display "$2" "$n" && echo "$n" ;;
  live) n=$(display_of "$2"); [ -n "$n" ] && owns_display "$2" "$n" && is_live "$n" && echo "$n" ;;
  list)
    for f in "$STATE"/*; do
      [[ "$f" == *.dbus ]] && continue
      [ -e "$f" ] || continue
      echo "$(basename "$f") $(cat "$f")"
    done
    ;;
  *)
    echo "usage: screenctl {start|stop|display|live|list} <bot-id>" >&2
    exit 2
    ;;
esac
